# Midnight Network
MIDNIGHT_NETWORK=testnet
MIDNIGHT_NODE_URL=https://rpc.devnet.midnight.network
MIDNIGHT_INDEXER_URL=https://indexer.devnet.midnight.network
MIDNIGHT_PROOF_SERVER_URL=https://prover.devnet.midnight.network

# Contract Addresses
MIDNIGHT_SURVEY_REGISTRY_ADDRESS=
MIDNIGHT_RESPONSE_REGISTRY_ADDRESS=
MIDNIGHT_ZK_VERIFIER_ADDRESS=

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=dev

# JWT
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_MAX=100

# Encryption
ENCRYPTION_KEY=change-this-to-a-32-byte-hex-string
