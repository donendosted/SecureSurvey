{
  "name": "@midnight-survey/shared-sdk",
  "version": "1.0.0",
  "description": "Shared Midnight SDK utilities and contract interactions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-contracts": "^0.6.0",
    "@midnight-ntwrk/midnight-js-network-id": "^0.6.0",
    "@midnight-ntwrk/midnight-js-types": "^0.6.0",
    "@midnight-ntwrk/midnight-js-utils": "^0.6.0",
    "@midnight-ntwrk/midnight-js-wallet-api": "^0.6.0",
    "@midnight-ntwrk/compact-runtime": "^0.6.0",
    "@midnight-survey/shared-types": "workspace:*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.0"
  }
}